# Required: generate once with `openssl rand -hex 32` and keep it across restarts.
JWT_SECRET_KEY=

# Host interface/port. Use 127.0.0.1 behind a reverse proxy on the same host.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=3000

# Build version shown on the Health page. Set to a release tag or git commit.
RMFAKECLOUD_VERSION=local
LOGLEVEL=info

# Optional settings passed to the application by env_file.
# STORAGE_URL=https://cloud.example.com
# RM_HTTPS_COOKIE=true
# RM_TRUST_PROXY=true

# Optional self-hosted handwriting OCR endpoint accepting PDF POST requests.
# LIBRARY_OCR_URL=http://ocr:8080/recognize
# Local backups default to /data/library/backups (persisted with ./data).
